{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeTransform",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:us-east-1:<ACCOUNT_ID>:function:wsc2026-transform-lambda"
    },
    {
      "Sid": "PutTarget",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/wsc2026-target-db"
    }
  ]
}
