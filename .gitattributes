# 셸 스크립트와 매니페스트는 항상 LF 로 저장/체크아웃한다.
# (CloudShell 등 Linux 에서 source/실행 시 CRLF 로 인한 $'\r' 에러 방지)
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.env  text eol=lf

# Terraform/스크립트/매니페스트/도커파일도 LF 고정 (Linux bastion/CloudShell의 local-exec, docker build 등에서 CRLF로 인한 \r 에러 방지)
*.tf       text eol=lf
*.tftpl    text eol=lf
*.tpl      text eol=lf
*.hcl      text eol=lf
*.json     text eol=lf
*.js       text eol=lf
*.py       text eol=lf
Dockerfile text eol=lf
*.conf     text eol=lf
*.lua      text eol=lf
