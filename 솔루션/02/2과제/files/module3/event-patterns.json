{
  "wsc2026-sg-change-rule": {
    "source": ["aws.ec2"],
    "detail-type": ["AWS API Call via CloudTrail"],
    "detail": {
      "eventSource": ["ec2.amazonaws.com"],
      "eventName": ["AuthorizeSecurityGroupIngress"]
    }
  },

  "wsc2026-role-change-rule": {
    "source": ["aws.ec2"],
    "detail-type": ["AWS API Call via CloudTrail"],
    "detail": {
      "eventSource": ["ec2.amazonaws.com"],
      "eventName": ["AssociateIamInstanceProfile", "ReplaceIamInstanceProfileAssociation"]
    }
  },

  "wsc2026-ec2-terminate-rule": {
    "source": ["aws.ec2"],
    "detail-type": ["EC2 Instance State-change Notification"],
    "detail": {
      "state": ["terminated"]
    }
  },

  "wsc2026-ec2-type-change-rule": {
    "source": ["aws.ec2"],
    "detail-type": ["AWS API Call via CloudTrail"],
    "detail": {
      "eventSource": ["ec2.amazonaws.com"],
      "eventName": ["ModifyInstanceAttribute"],
      "requestParameters": {
        "instanceType": {
          "value": [{"exists": true}]
        }
      }
    }
  },

  "wsc2026-ec2-stop-rule": {
    "source": ["aws.ec2"],
    "detail-type": ["EC2 Instance State-change Notification"],
    "detail": {
      "state": ["stopped"]
    }
  },

  "wsc2026-tag-rule": {
    "source": ["aws.config"],
    "detail-type": ["Config Rules Compliance Change"],
    "detail": {
      "configRuleName": ["wsc2026-required-tags-rule"],
      "newEvaluationResult": {
        "complianceType": ["NON_COMPLIANT"]
      }
    }
  }
}
