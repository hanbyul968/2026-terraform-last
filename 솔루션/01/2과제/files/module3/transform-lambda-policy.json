{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadInboundBucket",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::wsc2026-wf-inbound-bucket",
        "arn:aws:s3:::wsc2026-wf-inbound-bucket/*"
      ]
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "*"
    }
  ]
}
