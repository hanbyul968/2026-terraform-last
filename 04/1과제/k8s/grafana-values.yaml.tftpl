# grafana/grafana values
# grafana 는 public.ecr.aws/quay 에 없고 docker.io/grafana/grafana 에만 존재하므로
# 이미지 override 없이 차트 기본(docker.io)으로 pull 한다(부팅 시 bootstrap_egress NAT 사용).

nodeSelector:
  type: monitoring

persistence:
  enabled: true
  existingClaim: ${pvc_name}

adminUser: admin
adminPassword: "${admin_password}"

# /grafana 서브패스 서빙 (채점 11-1: /grafana/api/...)
grafana.ini:
  server:
    root_url: "%(protocol)s://%(domain)s/grafana"
    serve_from_sub_path: true

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
      - name: Prometheus
        type: prometheus
        access: proxy
        url: ${ds_url}
        isDefault: true

# wsc-eks-dashboard configmap(label grafana_dashboard=1) 자동 로드
sidecar:
  dashboards:
    enabled: true
    label: grafana_dashboard
    searchNamespace: monitoring
