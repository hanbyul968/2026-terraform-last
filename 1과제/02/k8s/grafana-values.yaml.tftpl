# grafana/grafana values
# addon 노드 배치, Ingress(AWS Load Balancer Controller) 로 생성한
# ALB(wskorea26-grafana-alb) 를 통해 HTTP 80 으로 노출한다.
# 대시보드 URL: http://<alb-dns>/d/wskorea26/wskorea26-monitoring (루트 서빙)

nodeSelector:
  node-type: addon

persistence:
  enabled: true
  existingClaim: ${pvc_name}

adminUser: '${admin_user}'
adminPassword: '${admin_password}'

# Service 는 ClusterIP 로 두고 외부 노출은 아래 Ingress(ALB) 가 담당한다.
#   type: LoadBalancer 로 노출하면 AWS LB Controller 가 NLB 를 만든다.
#   과제 12 는 "ALB 를 구성합니다" 이므로 Ingress 를 사용해야 한다.
service:
  type: ClusterIP
  port: 80
  targetPort: 3000

# 과제 12 / 채점 10-0:
#   aws elbv2 describe-load-balancers --names wskorea26-grafana-alb 로 조회되고
#   HTTP 80 으로 Grafana Web 에 접근할 수 있어야 한다.
ingress:
  enabled: true
  ingressClassName: alb
  annotations:
    alb.ingress.kubernetes.io/load-balancer-name: wskorea26-grafana-alb
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: ip
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}]'
    # 태그 자동탐색에 의존하지 않도록 퍼블릭 서브넷을 이름으로 고정한다.
    alb.ingress.kubernetes.io/subnets: ${pub_subnets}
    alb.ingress.kubernetes.io/healthcheck-protocol: HTTP
    alb.ingress.kubernetes.io/healthcheck-path: /api/health
    alb.ingress.kubernetes.io/success-codes: "200"
  # host 없이 / 전체를 Grafana 로 보낸다(루트 접속 = Grafana Web).
  hosts: []
  path: /
  pathType: Prefix

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
      - name: Prometheus
        type: prometheus
        uid: prometheus
        access: proxy
        url: ${ds_url}
        isDefault: true

# wskorea26-dashboard configmap(label grafana_dashboard=1) 자동 로드
sidecar:
  dashboards:
    enabled: true
    label: grafana_dashboard
    searchNamespace: monitoring
