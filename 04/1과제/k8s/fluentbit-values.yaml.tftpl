# aws-for-fluent-bit values
# 이미지: ECR pull-through cache 경유 (노드 인터넷 없음)

# DaemonSet 이름을 정확히 "fluent-bit" 로 고정 (과제10 DaemonSet Name, 채점:
# `kubectl rollout restart daemonset fluent-bit`). override 없으면 chart fullname 이
# "fluent-bit-aws-for-fluent-bit" 가 되어 채점 명령과 불일치한다.
fullnameOverride: fluent-bit

image:
  repository: ${registry}/ecr-public/aws-observability/aws-for-fluent-bit
  tag: stable

serviceAccount:
  create: false
  name: ${sa_name}

# fluent-bit 은 모든 노드(app 포함)에서 app 로그 수집 -> DaemonSet
tolerations:
  - operator: Exists

filter:
  enabled: true
  # 클러스터 도메인이 wsc.local 로 바뀌어 기본 FQDN(kubernetes.default.svc.cluster.local)이
  # 해석 안 돼 kubernetes filter 가 크래시한다. 검색 도메인으로 풀리는 짧은 이름을 쓴다.
  kubeURL: https://kubernetes.default.svc:443

input:
  enabled: true

# CloudWatch 전송(기본 OUTPUT, Match *). grep 으로 /health 를 먼저 걸러낸 뒤 전송된다.
cloudWatchLogs:
  enabled: true
  region: ${region}
  logGroupName: ${log_group}
  logStreamPrefix: "app-"
  autoCreateGroup: false

# /health 요청 라인 제외 grep 필터 (채점 11-2-B: /health 이벤트 0, 11-2-A: /v1/book 이벤트 >0).
# 주의: 이 chart 의 filter.extraFilters 는 kubernetes [FILTER] 블록 "안"에 들여쓰기로 삽입되어
#       classic 포맷을 깨뜨린다(파싱 에러 -> CrashLoopBackOff). additionalOutputs 는 다른 섹션과
#       동일 들여쓰기(column 0)로 렌더되어 [FILTER] 가 유효하다. fluent-bit 은 [FILTER] 를 텍스트
#       위치와 무관하게 선언 순서대로 파이프라인에 넣으므로 kubernetes filter 뒤에 실행된다.
#       kubernetes filter 는 Keep_Log On 이라 원본 라인이 log 필드에 남아 grep 이 매칭된다.
additionalOutputs: |
  [FILTER]
      Name    grep
      Match   *
      Exclude log /health
