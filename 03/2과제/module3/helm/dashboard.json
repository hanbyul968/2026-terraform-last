{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "wsc2026-app-logs",
  "uid": "wsc2026-app-logs",
  "tags": ["wsc2026"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(namespace_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Log Level Trend",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "INFO" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        { "expr": "sum(log_record_count_total{level=\"INFO\"})", "legendFormat": "INFO", "refId": "A" },
        { "expr": "sum(log_record_count_total{level=\"WARN\"})", "legendFormat": "WARN", "refId": "B" },
        { "expr": "sum(log_record_count_total{level=\"ERROR\"})", "legendFormat": "ERROR", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (%) / Warn Rate (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "100 * sum(log_record_count_total{level=\"ERROR\"}) / clamp_min(sum(log_record_count_total),1)", "legendFormat": "Error Rate %", "refId": "A" },
        { "expr": "100 * sum(log_record_count_total{level=\"WARN\"}) / clamp_min(sum(log_record_count_total),1)", "legendFormat": "Warn Rate %", "refId": "B" }
      ]
    },
    {
      "type": "piechart",
      "title": "Level Distribution",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "targets": [
        { "expr": "sum(log_record_count_total) by (level)", "legendFormat": "{{level}}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Error Count",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 9 },
      "targets": [ { "expr": "sum(log_record_count_total{level=\"ERROR\"})", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Warning Count",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 9 },
      "targets": [ { "expr": "sum(log_record_count_total{level=\"WARN\"})", "refId": "A" } ]
    },
    {
      "type": "stat",
      "title": "Total Logs",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 9 },
      "targets": [ { "expr": "sum(log_record_count_total)", "refId": "A" } ]
    },
    {
      "type": "gauge",
      "title": "Error Rate (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 13 },
      "targets": [ { "expr": "100 * sum(log_record_count_total{level=\"ERROR\"}) / clamp_min(sum(log_record_count_total),1)", "refId": "A" } ]
    },
    {
      "type": "gauge",
      "title": "Warn Rate (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 13 },
      "targets": [ { "expr": "100 * sum(log_record_count_total{level=\"WARN\"}) / clamp_min(sum(log_record_count_total),1)", "refId": "A" } ]
    },
    {
      "type": "row",
      "title": "Logs by Level",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Log Count by Level",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "targets": [
        { "expr": "sum(log_record_count_total) by (level)", "legendFormat": "{{level}}", "refId": "A" }
      ]
    }
  ]
}
