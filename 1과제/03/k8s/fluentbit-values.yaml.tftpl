# aws-for-fluent-bit values (과제 11)
# DaemonSet으로 모든 노드에서 wsc2026 애플리케이션 로그를 수집한다.
serviceAccount:
  create: false
  name: ${sa_name}

# addon/workload 노드의 taint와 관계없이 각 노드에 1개씩 실행한다.
tolerations:
  - operator: Exists

resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    memory: 256Mi

# chart 기본값은 kubernetes.default.svc.cluster.local로 고정되어 있어
# 커스텀 클러스터 도메인(wsc2026.skills.local)에서는 DNS 해석에 실패한다.
filter:
  kubeURL: "https://kubernetes.default.svc.${cluster_domain}:443"

cloudWatchLogs:
  enabled: true
  match: "kube.*"
  region: ${region}
  logGroupName: ${log_group}
  logStreamPrefix: "app-"
  logKey: log
  autoCreateGroup: false
  autoRetryRequests: true

# book 앱의 `INFO {json}` 로그에서 구조화 필드를 추출하되 원본 log도 보존한다.
service:
  extraParsers: |
    [PARSER]
        Name         book_json
        Format       regex
        Regex        ^(?<level>[A-Z]+)\s+(?<payload>\{.*\})$

# aws-for-fluent-bit 차트에서 완전한 FILTER 블록은 additionalFilters 키를 사용한다.
additionalFilters: |
  [FILTER]
      Name         grep
      Match        kube.*
      Regex        $kubernetes['namespace_name'] ^wsc2026$
  [FILTER]
      Name         parser
      Match        kube.*
      Key_Name     log
      Parser       book_json
      Reserve_Data On
      Preserve_Key On
  [FILTER]
      Name         parser
      Match        kube.*
      Key_Name     payload
      Parser       json
      Reserve_Data On
      Preserve_Key On
  [FILTER]
      Name         grep
      Match        kube.*
      Exclude      path ^/health$
