# kube-prometheus-stack values (문제지 Reference02)

prometheus:
  prometheusSpec:
    retention: 7d
    evaluationInterval: 15s
    nodeSelector:
      wsc2026/node: addon
    podMonitorSelectorNilUsesHelmValues: false
    serviceMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
  additionalServiceMonitors:
    - name: wsc2026-book
      namespaceSelector:
        matchNames:
          - wsc2026
      selector:
        matchLabels:
          app: wsc2026-book
      endpoints:
        - port: http
          path: /metrics
          interval: 15s
          scrapeTimeout: 10s

alertmanager:
  enabled: true
  alertmanagerSpec:
    nodeSelector:
      wsc2026/node: addon

prometheusOperator:
  nodeSelector:
    wsc2026/node: addon

prometheus-node-exporter:
  tolerations:
    - operator: Exists

kube-state-metrics:
  nodeSelector:
    wsc2026/node: addon

grafana:
  adminUser: admin
  adminPassword: "${admin_password}"
  nodeSelector:
    wsc2026/node: addon
  serviceAccount:
    create: true
    name: grafana-sa
  service:
    type: LoadBalancer
    annotations:
      service.beta.kubernetes.io/aws-load-balancer-type: external
      service.beta.kubernetes.io/aws-load-balancer-nlb-target-type: ip
      service.beta.kubernetes.io/aws-load-balancer-scheme: internet-facing
  sidecar:
    dashboards:
      enabled: true
      label: grafana_dashboard
      searchNamespace: observability
    datasources:
      enabled: true
      defaultDatasourceEnabled: false
  additionalDataSources:
    - name: prometheus
      uid: prometheus
      type: prometheus
      access: proxy
      url: http://kube-prometheus-stack-prometheus.observability.svc.${cluster_domain}:9090
      isDefault: true
    - name: alertmanager
      uid: alertmanager
      type: alertmanager
      access: proxy
      url: http://kube-prometheus-stack-alertmanager.observability.svc.${cluster_domain}:9093
      jsonData:
        implementation: prometheus
    - name: cloudwatch
      uid: cloudwatch
      type: cloudwatch
      access: proxy
      jsonData:
        authType: default
        defaultRegion: ${region}
        logGroups:
          - arn: ""
            name: ${log_group}

additionalPrometheusRulesMap:
  wsc2026-rules:
    groups:
      - name: wsc2026.rules
        rules:
          - alert: PodHighCPU
            expr: |
              sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!="",namespace="wsc2026"}[2m]))
                / clamp_min(sum by (namespace, pod) (kube_pod_container_resource_limits{resource="cpu",namespace="wsc2026"}), 0.001) > 0.8
            for: 3m
            labels:
              severity: warning
            annotations:
              summary: "Pod CPU usage exceeded 80% for 3 minutes"

          - alert: PodHighMemory
            expr: |
              sum by (namespace, pod) (container_memory_working_set_bytes{container!="",namespace="wsc2026"})
                / clamp_min(sum by (namespace, pod) (kube_pod_container_resource_limits{resource="memory",namespace="wsc2026"}), 1) > 0.9
            for: 3m
            labels:
              severity: warning
            annotations:
              summary: "Pod memory usage exceeded 90% for 3 minutes"

          - alert: PodNotReady
            expr: |
              kube_pod_status_ready{namespace="wsc2026",condition="true"} == 0
                or kube_pod_container_status_waiting_reason{namespace="wsc2026",reason="CrashLoopBackOff"} == 1
            for: 3m
            labels:
              severity: critical
            annotations:
              summary: "Pod is in CrashLoopBackOff or has not been Ready for 3 minutes"

          - alert: HighErrorRate
            expr: |
              sum(rate(http_requests_total{namespace="wsc2026",status=~"4..|5.."}[1m]))
                / clamp_min(sum(rate(http_requests_total{namespace="wsc2026"}[1m])), 0.001) > 0.05
            for: 1m
            labels:
              severity: critical
            annotations:
              summary: "HTTP 4xx/5xx ratio exceeded 5% for 1 minute"

          - alert: HighLatency
            expr: |
              sum(rate(http_request_duration_seconds_sum{namespace="wsc2026"}[1m]))
                / clamp_min(sum(rate(http_request_duration_seconds_count{namespace="wsc2026"}[1m])), 0.001) > 3
            for: 3m
            labels:
              severity: warning
            annotations:
              summary: "Average response time exceeded 3 seconds for 3 minutes"

          - alert: PodCrashLooping
            expr: |
              kube_pod_container_status_restarts_total{namespace="wsc2026"} > 3
            for: 3m
            labels:
              severity: critical
            annotations:
              summary: "Container restart count exceeded 3 for 3 minutes"
