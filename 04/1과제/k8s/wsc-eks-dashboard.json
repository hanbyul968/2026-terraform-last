{
  "uid": "wsc-eks-dashboard",
  "title": "wsc-eks-dashboard",
  "tags": ["wsc"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "TOTAL_NODE_GROUP_COUNT",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "count(kube_node_info)" }
      ]
    },
    {
      "id": 2,
      "title": "APP_POD_COUNT",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "count(kube_pod_labels{namespace=\"wsc\", label_app=\"wsc-deploy\"})" }
      ]
    },
    {
      "id": 3,
      "title": "NODE_GROUP_CPU_USAGE",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))" }
      ]
    },
    {
      "id": 4,
      "title": "NODE_GROUP_MEMORY_USAGE",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (instance) (node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes)" }
      ]
    },
    {
      "id": 5,
      "title": "APP_POD_CPU_USAGE",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"wsc\", pod=~\"wsc-deploy.*\", container!=\"\"}[5m]))" }
      ]
    },
    {
      "id": 6,
      "title": "APP_POD_MEMORY_USAGE",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"wsc\", pod=~\"wsc-deploy.*\", container!=\"\"})" }
      ]
    }
  ]
}
