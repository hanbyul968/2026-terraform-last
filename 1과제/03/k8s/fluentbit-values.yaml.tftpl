# aws-for-fluent-bit values (과제 11)
# DaemonSet으로 모든 노드에서 wsc2026 애플리케이션 로그를 수집한다.
serviceAccount:
  create: false
  name: ${sa_name}

# addon/workload 노드의 taint와 관계없이 각 노드에 1개씩 실행한다.
tolerations:
  - operator: Exists

resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    memory: 256Mi

# chart 기본값은 kubernetes.default.svc.cluster.local로 고정되어 있어
# 커스텀 클러스터 도메인(wsc2026.skills.local)에서는 DNS 해석에 실패한다.
filter:
  kubeURL: "https://kubernetes.default.svc.${cluster_domain}:443"

cloudWatchLogs:
  enabled: true
  match: "kube.*"
  region: ${region}
  logGroupName: ${log_group}
  logStreamPrefix: "app-"
  logKey: log
  autoCreateGroup: false
  autoRetryRequests: true

# 파싱/필터/메트릭은 helm values로 넣지 않는다.
# 지급 book 앱은 logfmt(`YYYY/MM/DD HH:MM:SS access method=.. path=.. status=.. duration=..`)라
# 기존 book_json(=INFO {json} 기대) 파서가 맞지 않고, Lua 재구성 + log_to_metrics + prometheus_exporter는
# 차트 values로 주입이 어렵다. → helm 설치 후 main.tf 의 null_resource.fluentbit_config 가
# configmap(fb/fluent-bit.conf, parser_extra.conf, reformat.lua)을 직접 교체하고 DaemonSet을 재시작한다.
#   - logfmt → Reference02 JSON(`INFO {json}`) 재구성 (11-3 로그 형식)
#   - /v1/book 로그만 CloudWatch 전송 (채점 확정: 그 외 경로 차단)
#   - log_to_metrics 로 http_requests_total 생성 → HighErrorRate (fb/fb-metrics-sm.yaml 의 ServiceMonitor로 수집)
