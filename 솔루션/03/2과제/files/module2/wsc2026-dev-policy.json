{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyEC2AndS3InSeoulOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:Get*",
        "s3:Get*",
        "s3:List*",
        "s3:Describe*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2"
        }
      }
    }
  ]
}
